From 8ae15fc0c22cd56bbc0a43d8f574e4d45406e7bf Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Fri, 29 May 2026 16:13:54 +0200
Subject: [PATCH] Drop SHLINKFLAGS rpath -- LINKFLAGS already covers shared
 libs

SCons applies LINKFLAGS to both SharedLibrary() and Program() builds,
so adding `-Wl,-rpath,...` via SHLINKFLAGS *as well* meant every
shared lib got the same -rpath flag twice and ld printed
"duplicate -rpath ... ignored" warnings (~22 per osx job in the
conda-forge build). The resulting RUNPATH was already correctly
deduped, but the warnings drowned the build log.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 SConstruct | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/SConstruct b/SConstruct
index fe2153aad..8ed56c8c9 100644
--- a/SConstruct
+++ b/SConstruct
@@ -626,9 +626,10 @@ if not env['IS_WINDOWS']:
     # libomp / libgomp / boost / etc.
     _libesys = os.path.join(env['prefix'], 'lib', 'esys')
     _libdir  = os.path.join(env['prefix'], 'lib')
-    _rpaths  = ["-Wl,-rpath," + _libesys, "-Wl,-rpath," + _libdir]
-    env.AppendUnique(SHLINKFLAGS = _rpaths)
-    env.AppendUnique(LINKFLAGS   = _rpaths)
+    # Add to LINKFLAGS only -- SCons uses LINKFLAGS for both Program() and
+    # SharedLibrary() builds, so listing the rpath in SHLINKFLAGS too made
+    # ld warn "duplicate -rpath ... ignored" on every shared lib.
+    env.AppendUnique(LINKFLAGS = ["-Wl,-rpath," + _libesys, "-Wl,-rpath," + _libdir])
 
 if env['build_trilinos'] != 'never':
     if not os.path.isdir(env['trilinos_build']): # create a build folder if the user deleted it
-- 
