From 6564a4816427d8b43d7ef0ffdb13dc8e133c79a8 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 22:36:42 +0200
Subject: [PATCH] Surface the exception text on boost_numpy probe failure

The bare `except:` was swallowing the actual RuntimeError, so the
"Could not find boost/python/numpy.hpp. Building without numpy
support." message was identical whether the failure was a missing
header or a failed link test. Print the exception text alongside the
warning so we can diagnose conda-forge failures from the build log.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 site_scons/dependencies.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/site_scons/dependencies.py b/site_scons/dependencies.py
index 8a168f6e6..8a247cf3b 100644
--- a/site_scons/dependencies.py
+++ b/site_scons/dependencies.py
@@ -380,8 +380,8 @@ def checkBoost(env):
             env.PrependENVPath(env['LD_LIBRARY_PATH_KEY'], boost_numpy_lib_path)
             env.Append(CPPDEFINES=['ESYS_HAVE_BOOST_NUMPY'])
             env['have_boost_numpy'] = True
-        except:
-            print("Warning: Could not find boost/python/numpy.hpp. Building without numpy support.")
+        except Exception as e:
+            print("Warning: Could not find boost/python/numpy.hpp. Building without numpy support. (reason: %s)" % e)
 
     if boostversion >= 107000:
         env.Append(CPPDEFINES=['ESYS_DEPRECATED_BOOST_ENDIAN'])
-- 
2.43.0

