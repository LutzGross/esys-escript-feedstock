From de63faea103ddbabef1936520fa9c8c337a8bf58 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 17:55:08 +0200
Subject: [PATCH] Use && instead of `and` keyword for MSVC compatibility

`and`, `or`, `not` are valid C++ keyword alternatives for &&, ||, !
but MSVC only recognizes them with /permissive- or /Za. The
conda-forge Windows build uses default MSVC flags, so the bare `and`
caused C2146/C2065 errors. Replace the single occurrence with &&.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 escriptcore/src/DataFactory.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/escriptcore/src/DataFactory.cpp b/escriptcore/src/DataFactory.cpp
index 19c7c9b9b..e0f2a690d 100644
--- a/escriptcore/src/DataFactory.cpp
+++ b/escriptcore/src/DataFactory.cpp
@@ -644,7 +644,7 @@ Data load_hdf5(const std::string fileName, const AbstractDomain& domain)
         return load_hdf5grp(h5_file.openGroup("Data"), domain);
 
     }
-    else if ( h5_file.nameExists("Data_Re") and h5_file.nameExists("Data_Im") )
+    else if ( h5_file.nameExists("Data_Re") && h5_file.nameExists("Data_Im") )
     {
             Data data_re = load_hdf5grp(h5_file.openGroup("Data_Re"), domain);
             Data data_im = load_hdf5grp(h5_file.openGroup("Data_Im"), domain);
-- 
2.43.0

