From 7198aa8a1b601fe52480435ab5e071e48d44056e Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Thu, 28 May 2026 21:18:20 +0200
Subject: [PATCH] Use raw strings for the gmsh GEO templates

Python 3.12+ warns on the literal `\{` / `\}` / `\;` sequences in
these multi-line gmsh-source templates as SyntaxWarning: invalid
escape sequence. Mark the strings raw -- they don't carry any
intentional escapes so the in-memory contents are unchanged.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 finley/test/python/generate_meshes.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/finley/test/python/generate_meshes.py b/finley/test/python/generate_meshes.py
index baaf65f4d..fb072cbb8 100644
--- a/finley/test/python/generate_meshes.py
+++ b/finley/test/python/generate_meshes.py
@@ -50,7 +50,7 @@ from esys.finley import ReadGmsh
 from esys.weipa import saveVTK
 import os
 GEO = { 2 :
-"""
+r"""
 Mesh.MshFileVersion = 2.2;
 Mesh.ElementOrder = {o};
 l_X={l_X};
@@ -69,7 +69,7 @@ Physical Curve(100) = \{1, 12, 23, 30\};
 Physical Surface(200) = \{1\};
 """,
         3 :
-"""
+r"""
 Mesh.MshFileVersion = 2.2;
 Mesh.ElementOrder = {o};
 l_X={l_X};
-- 
2.43.0

