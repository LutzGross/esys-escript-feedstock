From e4f0d73bfb2337544611785220178f7c35dcdeef Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 17:31:13 +0200
Subject: [PATCH] Use signed loop counters for OpenMP-for loops

MSVC's /openmp (OpenMP 2.0) requires the loop variable in a parallel
'for' to be a signed integral type. The unsigned size_t counters here
broke the Windows build with error C3016. Switch to ptrdiff_t (or
dim_t where the bound is already signed) to keep GCC/Clang behavior
unchanged while satisfying MSVC.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 escriptcore/src/Data.cpp    | 4 ++--
 finley/src/NodeFile.cpp     | 4 ++--
 ripley/src/RipleyDomain.cpp | 3 ++-
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/escriptcore/src/Data.cpp b/escriptcore/src/Data.cpp
index 7f4f92762..6524229f2 100644
--- a/escriptcore/src/Data.cpp
+++ b/escriptcore/src/Data.cpp
@@ -968,9 +968,9 @@ Data::maskWorker(Data& other2, Data& mask2, S sentinel)
         // Scalar mask applied per data point (Expanded or Constant).
         // mvec has one entry per data point; self/ovec have psize entries per data point.
         size_t psize = getDataPointSize();
-        size_t num_dp = getNumDataPoints();
+        const ptrdiff_t num_dp = static_cast<ptrdiff_t>(getNumDataPoints());
         #pragma omp parallel for schedule(static)
-        for (size_t pt = 0; pt < num_dp; ++pt)
+        for (ptrdiff_t pt = 0; pt < num_dp; ++pt)
         {
             if (mvec[pt] > 0)
             {
diff --git a/finley/src/NodeFile.cpp b/finley/src/NodeFile.cpp
index e9e8ca470..684090e10 100644
--- a/finley/src/NodeFile.cpp
+++ b/finley/src/NodeFile.cpp
@@ -974,11 +974,11 @@ void NodeFile::createDOFMappingAndCoupling(bool use_reduced_elements)
 #pragma omp parallel
     {
 #pragma omp for nowait
-        for (size_t i = 0; i < myNumTargets; i++) {
+        for (dim_t i = 0; i < myNumTargets; i++) {
             myRows[i] = globalDOFIndex[dofMap[i]];
         }
 #pragma omp for
-        for (size_t i = 0; i < numTargets; i++) {
+        for (dim_t i = 0; i < numTargets; i++) {
             columns[i] = globalDOFIndex[dofMap[i]];
         }
     } // end parallel section
diff --git a/ripley/src/RipleyDomain.cpp b/ripley/src/RipleyDomain.cpp
index 7129dbd5a..fc9888d44 100644
--- a/ripley/src/RipleyDomain.cpp
+++ b/ripley/src/RipleyDomain.cpp
@@ -1443,8 +1443,9 @@ esys_trilinos::const_TrilinosGraph_ptr RipleyDomain::createTrilinosGraph(
     IndexVector columns(getNumNodes());
     // order is important - our columns (=myRows) come first, followed by
     // shared ones (=node Id for non-DOF)
+    const ptrdiff_t numCols = static_cast<ptrdiff_t>(columns.size());
 #pragma omp parallel for
-    for (size_t i=0; i<columns.size(); i++) {
+    for (ptrdiff_t i=0; i<numCols; i++) {
         columns[getDofOfNode(i)] = myColumns[i];
     }
     TrilinosMap_ptr colMap(new MapType(getNumDataPointsGlobal(), columns,
-- 
