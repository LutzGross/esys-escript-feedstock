From 5ff800c725346eaa00dcc23f1b7d7afa3248e290 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 22:56:46 +0200
Subject: [PATCH] Normalise boost_libs before concatenating in boost_numpy
 probe

env['boost_libs'] is a list when set via an scons options file but a
string when set via the scons CLI (which is how the conda-forge
recipe does it). The boost_numpy probe was doing
`[libname] + env['boost_libs']` and crashing with
"can only concatenate list (not 'str') to list" -- swallowed by the
bare except, which silently disabled boost_numpy support on every
conda-forge platform.

Coerce to a list before concatenating so both styles work.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 site_scons/dependencies.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/site_scons/dependencies.py b/site_scons/dependencies.py
index 8a247cf3b..55deb0eeb 100644
--- a/site_scons/dependencies.py
+++ b/site_scons/dependencies.py
@@ -370,9 +370,14 @@ def checkBoost(env):
             libname = f'boost_numpy{pyv[0]}{pyv[1]}'
         else:
             libname = f'boost_numpy{pyv[0]}{pyv[1]}'
+        # env['boost_libs'] may be a list (from an options file) or a string
+        # (when set on the scons CLI), so normalise before concatenating.
+        boost_libs = env['boost_libs']
+        if isinstance(boost_libs, str):
+            boost_libs = [boost_libs]
         try:
             boost_numpy_inc_path, boost_numpy_lib_path = \
-                findLibWithHeader(env, [ libname ] + env['boost_libs'], os.path.join('boost', 'python', 'numpy.hpp'), env['boost_prefix'], lang='c++')
+                findLibWithHeader(env, [ libname ] + list(boost_libs), os.path.join('boost', 'python', 'numpy.hpp'), env['boost_prefix'], lang='c++')
             env.AppendUnique(LIBS=libname)
             env.AppendUnique(boost_libs=libname)
             env.AppendUnique(CPPPATH=boost_numpy_inc_path)
