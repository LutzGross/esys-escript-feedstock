From 49237fdc23ae61dfec273e2a6392544f68b7d6de Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 19:30:22 +0200
Subject: [PATCH] Don't propagate ESCRIPT_EXPORTS to the Python wrapper on
 Windows

escriptcpp.pyd is a consumer of escript.dll, not part of it, so the
class declarations it sees through escript headers must resolve to
__declspec(dllimport). Until now py_env was Cloned from local_env
after ESCRIPT_EXPORTS was appended, so it inherited the export macro
and tried to (re-)export static class members like
NullDomain::NullDomainFS that live in the .dll. Strip ESCRIPT_EXPORTS
from py_env's CPPDEFINES to fix three unresolved-external link errors.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 escriptcore/src/SConscript | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/escriptcore/src/SConscript b/escriptcore/src/SConscript
index aa92e53cb..19bae7fcb 100644
--- a/escriptcore/src/SConscript
+++ b/escriptcore/src/SConscript
@@ -152,8 +152,12 @@ else:
 
 ### Python wrapper ###
 py_env = local_env.Clone()
-#if IS_WINDOWS:
-#    py_env.Append(CPPDEFINES = ['ESCRIPT_EXPORTS'])
+if IS_WINDOWS:
+    # The .pyd is a CONSUMER of escript.dll, so ESCRIPT_DLL_API must
+    # resolve to __declspec(dllimport) here -- drop ESCRIPT_EXPORTS that
+    # was inherited from local_env (where it's needed to build the .dll).
+    py_env['CPPDEFINES'] = [d for d in py_env.get('CPPDEFINES', [])
+                            if d != 'ESCRIPT_EXPORTS']
 if IS_OSX:
     py_env.Prepend(LIBS = [ lib_inst ])
 else:
-- 
