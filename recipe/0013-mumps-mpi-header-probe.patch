From 83e0683637335694542186de53435cde668c9e7e Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Thu, 28 May 2026 16:21:19 +0200
Subject: [PATCH] Probe for MUMPS' MPI shim header on Windows

The Windows-only `#include <mumps_mpi.h>` in paso/src/MUMPS.h was
written for a system/vcpkg layout of MUMPS, but conda-forge's
mumps-seq package puts the equivalent shim at <mumps_seq/mpi.h>
(under include/mumps_seq/ next to the rest of the package's
mumps_seq-specific headers).

Use __has_include to pick whichever one is present, defaulting to
the conda-forge layout. C++17 already required by the project.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 paso/src/MUMPS.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/paso/src/MUMPS.h b/paso/src/MUMPS.h
index b44bf6cfc..d443e9c47 100755
--- a/paso/src/MUMPS.h
+++ b/paso/src/MUMPS.h
@@ -34,7 +34,11 @@
     #endif
 #endif
 #ifdef _WIN32
-#include <mumps_mpi.h>
+#  if __has_include(<mumps_seq/mpi.h>)
+#    include <mumps_seq/mpi.h>     // conda-forge mumps-seq layout
+#  elif __has_include(<mumps_mpi.h>)
+#    include <mumps_mpi.h>         // system / vcpkg MUMPS layout
+#  endif
 #endif
 // TODO: is this needed? #pragma pop_macro("MPI_COMM_WORLD")
 #include <dmumps_c.h>
