From 5b037acdbccf2a739097c71f8a6eb438afc7bba3 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 19:51:48 +0200
Subject: [PATCH] Skip pythonMPIcpp.pyd when mpi4py is disabled

The Python wrapper source pythonMPIcpp.cpp is empty outside of
ESYS_HAVE_MPI4PY, so when mpi4py is off the resulting .pyd has no
exported symbols and MSVC's linker emits no .exp file. The install
step then dies trying to copy a non-existent .exp into the prefix.
Gate the .pyd target on env['mpi4py'] so non-MPI Windows builds skip
it entirely.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 pythonMPI/src/SConscript | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/pythonMPI/src/SConscript b/pythonMPI/src/SConscript
index 89f2863ae..c6e326758 100644
--- a/pythonMPI/src/SConscript
+++ b/pythonMPI/src/SConscript
@@ -40,14 +40,20 @@ hdr_inst = local_env.Install(include_path, headers)
 
 lib_inst = local_env.Install(local_env['libinstall'], progs)
 
-py_env = local_env.Clone()
-# py_env.Prepend(LIBS = ['pythonMPI'])
-py_lib = py_env.PythonModule('pythonMPIcpp', 'pythonMPIcpp.cpp')
-mod_path = Dir('pythonMPI', local_env['pyinstall'])
-mod_inst = py_env.Install(mod_path, py_lib)
+# Only build the Python module when mpi4py is enabled. Without
+# ESYS_HAVE_MPI4PY the source file contains no BOOST_PYTHON_MODULE
+# block, so MSVC produces a .pyd with no exports and the install step
+# fails trying to copy a .exp file the linker never emits.
+mod_inst = []
+if env['mpi4py']:
+    py_env = local_env.Clone()
+    # py_env.Prepend(LIBS = ['pythonMPI'])
+    py_lib = py_env.PythonModule('pythonMPIcpp', 'pythonMPIcpp.cpp')
+    mod_path = Dir('pythonMPI', local_env['pyinstall'])
+    mod_inst = py_env.Install(mod_path, py_lib)
 
 env.Alias('build_pythonMPI', progs)
-env.Alias('install_pythonMPI', [lib_inst,mod_inst])
+env.Alias('install_pythonMPI', [lib_inst, mod_inst])
 
 
 
