From 507131d94674cf22221db3bcf1147dad65c260e3 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 17:43:57 +0200
Subject: [PATCH] Use standard `unsigned int` instead of POSIX `uint`

The bare `uint` type is a POSIX/glibc extension exposed through
<sys/types.h>, not a standard C++ type. MSVC does not define it, so the
Windows build fails with C2065 ("'uint': undeclared identifier").
Replace with the standard `unsigned int`.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 escriptcore/src/DataConstant.cpp | 8 ++++----
 escriptcore/src/DataExpanded.cpp | 8 ++++----
 escriptcore/src/DataFactory.cpp  | 6 +++---
 escriptcore/src/DataTagged.cpp   | 8 ++++----
 finley/src/DomainFactory.cpp     | 6 +++---
 finley/src/ElementFile.cpp       | 6 +++---
 finley/src/FinleyDomain.cpp      | 6 +++---
 7 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/escriptcore/src/DataConstant.cpp b/escriptcore/src/DataConstant.cpp
index 6853e0ec5..e5032eae5 100644
--- a/escriptcore/src/DataConstant.cpp
+++ b/escriptcore/src/DataConstant.cpp
@@ -602,7 +602,7 @@ DataConstant::setToZero()
 #ifdef ESYS_HAVE_HDF5
 void DataConstant::dump_hdf5(const H5::Group h5_grp) const
 {
-    uint rank = getRank();
+    unsigned int rank = getRank();
     int fs_type=  getFunctionSpace().getTypeCode();
     const DataTypes::ShapeType& shape = getShape();
     if (isComplex())
@@ -624,8 +624,8 @@ void DataConstant::dump_hdf5(const H5::Group h5_grp) const
     try
     {
         // .... add meta data ............
-        uint h5_shape[DataTypes::maxRank]; // dataset dimensions
-        for (uint i = 0; i < rank; i++) {
+        unsigned int h5_shape[DataTypes::maxRank]; // dataset dimensions
+        for (unsigned int i = 0; i < rank; i++) {
             h5_shape[i]= shape[i];
         }
         hsize_t h5_shape_dims[1] = {rank};
@@ -637,7 +637,7 @@ void DataConstant::dump_hdf5(const H5::Group h5_grp) const
         H5::Attribute h5_typeid_attr = h5_dmeta.createAttribute("type_id", H5::PredType::NATIVE_INT, H5::DataSpace(1,h5_typeid_dims ) );
         h5_typeid_attr.write( H5::PredType::NATIVE_INT , h5_type_id );
 
-        uint h5_rank[1] = { static_cast<uint>(rank) };
+        unsigned int h5_rank[1] = { static_cast<unsigned int>(rank) };
         H5::Attribute h5_rank_attr = h5_dmeta.createAttribute("rank", H5::PredType::NATIVE_UINT, H5::DataSpace(1, h5_typeid_dims ) );
         h5_rank_attr.write( H5::PredType::NATIVE_UINT , h5_rank );
 
diff --git a/escriptcore/src/DataExpanded.cpp b/escriptcore/src/DataExpanded.cpp
