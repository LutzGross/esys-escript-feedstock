From 256e7bfa9644274ca7cd1251ec3945f19c7e2211 Mon Sep 17 00:00:00 2001
From: Lutz Gross <lutz.gross@gmail.com>
Date: Wed, 27 May 2026 18:18:25 +0200
Subject: [PATCH] Guard POSIX-only calls in Utils.cpp against _WIN32

popen/pclose and gethostname are POSIX functions not directly available
in MSVC. Map popen/pclose to _popen/_pclose on Windows (declared in
<stdio.h>) and skip the gethostname branch entirely on Windows so the
'unknown host' fallback is used. This unblocks the conda-forge Windows
build of escriptcore.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 escriptcore/src/Utils.cpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/escriptcore/src/Utils.cpp b/escriptcore/src/Utils.cpp
index 24a5381a2..a6a84350c 100644
--- a/escriptcore/src/Utils.cpp
+++ b/escriptcore/src/Utils.cpp
@@ -20,7 +20,10 @@
 
 #include <cstring>
 #include <fstream>
-#ifndef _WIN32
+#ifdef _WIN32
+# define popen  _popen
+# define pclose _pclose
+#else
 # include <unistd.h>
 #endif // _WIN32
 #include <string>
@@ -176,7 +179,7 @@ void printParallelThreadCnt()
 {
     char hname[64];
 
-#ifdef HAVE_GETHOSTNAME
+#if defined(HAVE_GETHOSTNAME) && !defined(_WIN32)
     gethostname(hname, 64);
     hname[63] = '\0';
 #else
-- 
2.43.0

